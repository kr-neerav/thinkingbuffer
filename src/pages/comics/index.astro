---
import Layout from '../../layouts/Layout.astro';

// We use import.meta.glob to fetch all markdown files in this directory and any subdirectories
const comics = Object.values(import.meta.glob('./**/*.md', { eager: true }));

// Sort comics by date, newest first
comics.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<Layout title="Comics - Thinking Buffer">
	<h1>Comics</h1>
	
	<div class="comics-grid">
		{comics.map(comic => (
			<article class="card comic-card-link">
				<a href={comic.url} style="display: block;">
					<div class="thumbnail">
						{/* Using the external CDN url from frontmatter as the thumbnail */}
						<img src={comic.frontmatter.image_url} alt={comic.frontmatter.title} loading="lazy" />
					</div>
					<div class="comic-info">
						<h2>{comic.frontmatter.title}</h2>
						<p class="date">{new Date(comic.frontmatter.date).toLocaleDateString('en-US', {
							year: 'numeric',
							month: 'short',
							day: 'numeric'
						})}</p>
					</div>
				</a>
				{comic.frontmatter.tags && (
					<div class="card-tags" style="padding: 0 1rem 1rem 1rem;">
						{comic.frontmatter.tags.map((tag: string) => (
							<a href={`/tags/${tag}`} class="tag">{tag}</a>
						))}
					</div>
				)}
			</article>
		))}
	</div>
</Layout>

<style>
	.comics-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 2rem;
	}
	
	.comic-card-link {
		padding: 0;
		overflow: hidden;
	}
	
	.thumbnail {
		width: 100%;
		aspect-ratio: 16/9;
		background-color: var(--border-color);
		overflow: hidden;
	}
	
	.thumbnail img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}
	
	.comic-card-link:hover .thumbnail img {
		transform: scale(1.05);
	}
	
	.comic-info {
		padding: 1rem;
	}
	
	.comic-info h2 {
		margin-bottom: 0.25rem;
		font-size: 1.25rem;
	}
	
	.date {
		font-size: 0.85rem;
		color: var(--text-muted);
		margin-bottom: 0;
	}
</style>
