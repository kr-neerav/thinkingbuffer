---
import Layout from '../../../layouts/Layout.astro';

const booksSummary = [
  { 
    num: 1, 
    slug: 'Book_01_Bala_Kanda',
    name: 'Bāla Kāṇḍa', 
    sanskrit: 'बालकाण्ड', 
    english: 'The Book of Youth & Childhood',
    count: 75, 
    readyCount: 2,
    words: '~53,400', 
    desc: 'Origins of the epic, divine birth of Rama and his brothers, journey with Sage Vishvamitra, slaying of Tataka & Subahu, redemption of Ahalya, breaking of Lord Shiva\'s bow in Mithila, and the royal wedding.',
    heroImg: '/images/comics/Book_1_Bala_Kanda_Chapter_1_hero.jpg'
  },
  { 
    num: 2, 
    slug: 'Book_02_Ayodhya_Kanda',
    name: 'Ayodhyā Kāṇḍa', 
    sanskrit: 'अयोध्याकाण्ड', 
    english: 'The Book of Ayodhya & Exile',
    count: 118, 
    readyCount: 0,
    words: '~100,500', 
    desc: 'Preparations for Rama\'s coronation, Manthara\'s scheming, Queen Kaikeyi\'s boons, Rama\'s exile to Dandaka forest, Dasharatha\'s grief and demise, and Bharata\'s unyielding devotion with the sacred Padukas.'
  },
  { 
    num: 3, 
    slug: 'Book_03_Aranya_Kanda',
    name: 'Āraṇya Kāṇḍa', 
    sanskrit: 'अरण्यकाण्ड', 
    english: 'The Book of the Forest',
    count: 75, 
    readyCount: 0,
    words: '~56,200', 
    desc: 'Forest hermit life in Panchavati, disfigurement of Surpanakha, slaying of Khara and Dushana, the golden deer deception, Ravana\'s abduction of Sita, Jatayu\'s sacrifice, and Rama\'s search.'
  },
  { 
    num: 4, 
    slug: 'Book_04_Kishkindha_Kanda',
    name: 'Kiṣkindhā Kāṇḍa', 
    sanskrit: 'किष्किन्धाकाण्ड', 
    english: 'The Book of the Monkey Kingdom',
    count: 67, 
    readyCount: 0,
    words: '~55,800', 
    desc: 'Arrival at Lake Pampa, sacred alliance between Rama and Sugriva facilitated by Hanuman, the slaying of Vali, coronation of Sugriva, and the worldwide search parties sent out for Sita.'
  },
  { 
    num: 5, 
    slug: 'Book_05_Sundara_Kanda',
    name: 'Sundara Kāṇḍa', 
    sanskrit: 'सुन्दरकाण्ड', 
    english: 'The Book of Beauty & Hanuman',
    count: 66, 
    readyCount: 0,
    words: '~68,600', 
    desc: 'Hanuman\'s colossal leap across the southern ocean, crossing the obstacles of Surasa and Simhika, locating Sita in Ashoka Vatika, the confrontation with Ravana, and the burning of Lanka.'
  },
  { 
    num: 6, 
    slug: 'Book_06_Yuddha_Kanda',
    name: 'Yuddha Kāṇḍa', 
    sanskrit: 'युद्धकाण्ड', 
    english: 'The Book of the Great War',
    count: 128, 
    readyCount: 0,
    words: '~132,000', 
    desc: 'Building of the Setu ocean bridge, the grand siege of Lanka, defeat of Kumbhakarna and Indrajit, the climactic duel with Ravana, Sita\'s fire trial, and the triumphant return for coronation in Ayodhya.'
  },
  { 
    num: 7, 
    slug: 'Book_07_Uttara_Kanda',
    name: 'Uttara Kāṇḍa', 
    sanskrit: 'उत्तरकाण्ड', 
    english: 'The Book of the Epilogue',
    count: 123, 
    readyCount: 0,
    words: '~86,400', 
    desc: 'Ancient histories of the Rakshasas, Sita\'s hermitage life in Valmiki\'s ashram, birth and singing of Kusha and Lava at the Ashvamedha sacrifice, and the final ascension of the Raghu dynasty.'
  }
];

const totalChapters = booksSummary.reduce((acc, b) => acc + b.count, 0);
const totalReady = booksSummary.reduce((acc, b) => acc + b.readyCount, 0);
---

<Layout title="The Valmiki Ramayana - Graphic Novel Series - Thinking Buffer">
  <div class="ramayana-landing-container">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <span class="cur">Comics • Ramayana</span>
    </nav>

    <!-- Hero Header -->
    <header class="series-hero card">
      <span class="hero-eyebrow">Illustrated Graphic Novel Series</span>
      <h1 class="series-title">The Valmiki Ramayana</h1>
      <p class="series-subtitle">
        An unabridged, 1-to-1 chapter-by-chapter graphic novel adaptation mapped directly from Manmatha Nath Dutt's 1891 prose translation, cross-referenced with canonical Sanskrit Sargas.
      </p>

      <div class="series-stats-bar">
        <div class="s-stat">
          <strong>7</strong>
          <span>Kāṇḍas (Books)</span>
        </div>
        <div class="s-stat">
          <strong>{totalChapters}</strong>
          <span>Canonical Chapters</span>
        </div>
        <div class="s-stat">
          <strong>~551,900</strong>
          <span>Source Words</span>
        </div>
        <div class="s-stat highlight">
          <strong>{totalReady} Illustrated</strong>
          <span>Ready to Read ✨</span>
        </div>
      </div>
    </header>

    <!-- Featured Introduction Card -->
    <section class="intro-chapter-section">
      <h2 class="section-heading">Begin Here: The Odyssey Introduction</h2>
      <a href="/comics/ramayana/introduction/" class="card intro-card">
        <div class="intro-img-container">
          <img 
            src="/images/comics/ramayana_hero.jpg" 
            alt="Ramayana Odyssey Introduction" 
            loading="lazy"
          />
          <span class="badge-ready-overlay">✨ Illustrated Comic Ready • 7 Panels</span>
        </div>
        <div class="intro-content">
          <div class="intro-meta-tags">
            <span class="badge-kanda">Prologue</span>
            <span class="badge-sec">The Odyssey Introduction</span>
          </div>
          <h3 class="intro-title">Welcome to the Odyssey: An Illustrated Introduction</h3>
          <p class="intro-desc">
            Discover the textual foundation behind this graphic saga—how we preserve Manmatha Nath Dutt’s unabridged 1891 prose translation, the structural purpose of the opening Executive Summary cantos (Samkṣepa Rāmāyaṇa), and how ancient Dharma transforms into actionable modern wisdom.
          </p>
          <div class="intro-action-row">
            <span class="intro-btn">Read Introduction Comic →</span>
          </div>
        </div>
      </a>
    </section>

    <!-- 7 Books (Kāṇḍas) Section -->
    <section class="kandas-section">
      <div class="section-header-row">
        <div>
          <h2 class="section-heading">Explore the 7 Books (Kāṇḍas)</h2>
          <p class="section-subheading">Select any book below to view its complete chapter list, synopses, and illustrated comics.</p>
        </div>
      </div>

      <div class="kandas-grid">
        {booksSummary.map((b) => (
          <a href={`/comics/ramayana/${b.slug}/`} class="card kanda-portal-card">
            <div class="kanda-card-top">
              <span class="kanda-num-pill">Book {b.num} of 7</span>
              <span class="kanda-sanskrit-tag">{b.sanskrit}</span>
            </div>

            <h3 class="kanda-portal-name">{b.name}</h3>
            <h4 class="kanda-portal-english">{b.english}</h4>

            <p class="kanda-portal-desc">{b.desc}</p>

            <div class="kanda-portal-meta">
              <div class="meta-stats">
                <span><strong>{b.count}</strong> Chapters</span>
                <span>•</span>
                <span>{b.words} words</span>
              </div>
              <div class="readiness-indicator">
                {b.readyCount > 0 ? (
                  <span class="badge-active-ready">✨ {b.readyCount} Illustrated</span>
                ) : (
                  <span class="badge-in-progress">⏳ In Production</span>
                )}
              </div>
            </div>

            <div class="kanda-portal-cta">
              <span>View All {b.count} Chapters →</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .ramayana-landing-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .breadcrumbs a {
    color: var(--text-muted);
  }

  .breadcrumbs a:hover {
    color: var(--text-color);
    text-decoration: underline;
  }

  .breadcrumbs .sep {
    opacity: 0.4;
  }

  .breadcrumbs .cur {
    color: var(--text-color);
    font-weight: 600;
  }

  /* Series Hero */
  .series-hero {
    background: linear-gradient(135deg, #FFFDFB 0%, #FFF5ED 50%, #F5F7FA 100%);
    border: 1px solid rgba(184, 93, 25, 0.15);
    border-radius: 24px;
    padding: 3rem 2.5rem;
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .hero-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #b85d19;
    background: #fff4e8;
    padding: 0.35rem 1rem;
    border-radius: 100px;
    display: inline-block;
    margin-bottom: 1rem;
    border: 1px solid rgba(184, 93, 25, 0.2);
  }

  .series-title {
    font-size: 3rem;
    font-weight: 800;
    color: #1a1a1a;
    letter-spacing: -0.04em;
    margin-bottom: 0.75rem;
  }

  .series-subtitle {
    font-size: 1.15rem;
    color: #555555;
    max-width: 780px;
    margin: 0 auto 2rem auto;
    line-height: 1.6;
  }

  .series-stats-bar {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .s-stat {
    background: #ffffff;
    padding: 0.85rem 1.5rem;
    border-radius: 14px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 140px;
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  .s-stat strong {
    font-size: 1.4rem;
    color: #1a1a1a;
  }

  .s-stat span {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    font-weight: 500;
  }

  .s-stat.highlight {
    background: #fdf8f4;
    border-color: #f6d8be;
  }

  .s-stat.highlight strong {
    color: #b85d19;
  }

  /* Section Headings */
  .section-heading {
    font-size: 1.6rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 0.35rem;
    letter-spacing: -0.02em;
  }

  .section-subheading {
    font-size: 0.95rem;
    color: #666666;
    margin-bottom: 1.75rem;
  }

  /* Intro Chapter Card */
  .intro-chapter-section {
    margin-bottom: 3.5rem;
  }

  .intro-card {
    display: flex;
    flex-direction: row;
    padding: 0;
    border-radius: 20px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid rgba(184, 93, 25, 0.2);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .intro-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .intro-img-container {
    position: relative;
    width: 42%;
    min-height: 260px;
    background: #f4ede6;
    overflow: hidden;
  }

  .intro-img-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge-ready-overlay {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: #03543f;
    background: rgba(222, 247, 236, 0.95);
    backdrop-filter: blur(4px);
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
    border: 1px solid #bcf0da;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .intro-content {
    flex: 1;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .intro-meta-tags {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .badge-kanda {
    font-size: 0.72rem;
    font-weight: 600;
    color: #2b6cb0;
    background: #ebf4ff;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
  }

  .badge-sec {
    font-size: 0.72rem;
    font-weight: 500;
    color: #4a5568;
    background: #f7fafc;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
  }

  .intro-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .intro-desc {
    font-size: 0.9rem;
    color: #555555;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .intro-btn {
    display: inline-block;
    background: #1a1a1a;
    color: #ffffff;
    padding: 0.6rem 1.25rem;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* Kandas Grid */
  .kandas-section {
    margin-bottom: 4rem;
  }

  .kandas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .kanda-portal-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    box-shadow: var(--shadow-soft);
    border: 1px solid rgba(0, 0, 0, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .kanda-portal-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(184, 93, 25, 0.3);
  }

  .kanda-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .kanda-num-pill {
    font-size: 0.75rem;
    font-weight: 700;
    color: #b85d19;
    background: #fff4e8;
    padding: 0.25rem 0.7rem;
    border-radius: 100px;
    border: 1px solid rgba(184, 93, 25, 0.15);
  }

  .kanda-sanskrit-tag {
    font-size: 0.95rem;
    font-weight: 600;
    color: #718096;
  }

  .kanda-portal-name {
    font-size: 1.35rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 0.25rem;
  }

  .kanda-portal-english {
    font-size: 0.9rem;
    font-weight: 500;
    color: #4a5568;
    margin-bottom: 1rem;
  }

  .kanda-portal-desc {
    font-size: 0.85rem;
    color: #666666;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .kanda-portal-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid #f1f5f9;
    font-size: 0.8rem;
    margin-bottom: 1rem;
  }

  .meta-stats {
    color: #718096;
    display: flex;
    gap: 0.35rem;
  }

  .badge-active-ready {
    font-size: 0.72rem;
    font-weight: 700;
    color: #03543f;
    background: #def7ec;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    border: 1px solid #bcf0da;
  }

  .badge-in-progress {
    font-size: 0.72rem;
    font-weight: 500;
    color: #718096;
    background: #f7fafc;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
  }

  .kanda-portal-cta {
    font-size: 0.85rem;
    font-weight: 600;
    color: #b85d19;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  @media (max-width: 800px) {
    .intro-card {
      flex-direction: column;
    }
    .intro-img-container {
      width: 100%;
      height: 200px;
    }
    .series-title {
      font-size: 2.2rem;
    }
    .kandas-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
