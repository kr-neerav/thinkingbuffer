---
import Layout from '../../../layouts/Layout.astro';
import mappingData from '../../../data/ramayana_dutt_1to1_mapping.json';

export function getStaticPaths() {
  const books = [
    {
      book_num: 1,
      slug: 'Book_01_Bala_Kanda',
      name: 'Bāla Kāṇḍa',
      sanskrit: 'बालकाण्ड',
      english: 'The Book of Youth & Childhood',
      desc: 'Recounts the origin of the epic, the birth of Rama and his brothers, their education, journey with Sage Vishvamitra, slaying of Tataka and Subahu, redemption of Ahalya, breaking of Lord Shiva\'s bow in Mithila, the royal quadruple wedding, and the humbling of Parashurama.',
      total_words: '~53,400',
      total_chapters: 75
    },
    {
      book_num: 2,
      slug: 'Book_02_Ayodhya_Kanda',
      name: 'Ayodhyā Kāṇḍa',
      sanskrit: 'अयोध्याकाण्ड',
      english: 'The Book of Ayodhya & Exile',
      desc: 'Preparations for Rama\'s coronation, Manthara\'s instigation, Queen Kaikeyi\'s two boons, Dasharatha\'s grief, Rama\'s exile to the Dandaka forest with Sita and Lakshmana, King Dasharatha\'s passing, Bharata\'s righteous refusal of the crown, and the installation of Rama\'s sacred Padukas at Nandigrama.',
      total_words: '~100,500',
      total_chapters: 118
    },
    {
      book_num: 3,
      slug: 'Book_03_Aranya_Kanda',
      name: 'Āraṇya Kāṇḍa',
      sanskrit: 'अरण्यकाण्ड',
      english: 'The Book of the Forest',
      desc: 'Forest life in Panchavati, encounters with hermits, disfigurement of Surpanakha, destruction of Khara and Dushana\'s army, the magical golden deer (Maricha), the abduction of Sita by demon king Ravana, Jatayu\'s valiant sacrifice, and Rama\'s grief-stricken quest through the wilderness.',
      total_words: '~56,200',
      total_chapters: 75
    },
    {
      book_num: 4,
      slug: 'Book_04_Kishkindha_Kanda',
      name: 'Kiṣkindhā Kāṇḍa',
      sanskrit: 'किष्किन्धाकाण्ड',
      english: 'The Book of the Monkey Kingdom',
      desc: 'Arrival at Lake Pampa, sacred alliance between Rama and Sugriva facilitated by Hanuman, the slaying of Vali, coronation of Sugriva, deployment of Vanara search parties to all four corners of the earth, and Sampati\'s revelation of Sita\'s location in Lanka across the southern ocean.',
      total_words: '~55,800',
      total_chapters: 67
    },
    {
      book_num: 5,
      slug: 'Book_05_Sundara_Kanda',
      name: 'Sundara Kāṇḍa',
      sanskrit: 'सुन्दरकाण्ड',
      english: 'The Book of Beauty & Hanuman',
      desc: 'Hanuman\'s monumental leap across the roaring ocean, overcoming Surasa and Simhika, infiltration of the fortress city of Lanka, discovery of Sita in the Ashoka Vatika, delivery of the signet ring, confrontation with Ravana, burning of Lanka, and triumphant return with news of Sita.',
      total_words: '~68,600',
      total_chapters: 66
    },
    {
      book_num: 6,
      slug: 'Book_06_Yuddha_Kanda',
      name: 'Yuddha Kāṇḍa',
      sanskrit: 'युद्धकाण्ड',
      english: 'The Book of the Great War',
      desc: 'Vibhishana\'s refuge with Rama, construction of the Setu ocean bridge, massive siege of Lanka, heroic clashes of Vanara and Rakshasa warriors, the fall of Kumbhakarna and Indrajit, the climactic duel between Rama and Ravana, Sita\'s trial of fire, and the joyous return to Ayodhya for the grand coronation.',
      total_words: '~132,000',
      total_chapters: 128
    },
    {
      book_num: 7,
      slug: 'Book_07_Uttara_Kanda',
      name: 'Uttara Kāṇḍa',
      sanskrit: 'उत्तरकाण्ड',
      english: 'The Book of the Epilogue',
      desc: 'Ancient histories of the Rakshasas and Ravana\'s early conquests, the birth of Kusha and Lava in Sage Valmiki\'s hermitage, their singing of the Ramayana epic before King Rama at the Ashvamedha sacrifice, Sita\'s final embrace by Mother Earth, and the ultimate ascension of the Raghu dynasty to Vaikuntha.',
      total_words: '~86,400',
      total_chapters: 123
    }
  ];

  return books.map((book) => ({
    params: { book: book.slug },
    props: { book, allBooks: books }
  }));
}

const { book, allBooks } = Astro.props;

// Known ready/illustrated chapters
const publishedImages: Record<string, string> = {
  '1_1': '/images/comics/Book_1_Bala_Kanda_Chapter_1_hero.jpg'
};

// Dynamically discover all published comic chapters from local markdown files
const localComics = import.meta.glob('./**/*/index.md', { eager: true });
for (const [filePath, fileModule] of Object.entries(localComics)) {
  const mod: any = fileModule;
  const fm = mod?.frontmatter || {};
  if (fm.status === 'published' && fm.book_num !== undefined && fm.section_number !== undefined) {
    const key = `${fm.book_num}_${fm.section_number}`;
    const parts = filePath.split('/');
    const chapterDir = parts[parts.length - 2];
    publishedImages[key] = publishedImages[key] || `/images/comics/${chapterDir}_hero.jpg`;
  }
}

// Filter chapters for this book
const rawChapters = mappingData.filter((item: any) => item.book_num === book.book_num);
const bookChapters = rawChapters;

const chapterList = bookChapters.map((chap: any) => {
  const key = `${chap.book_num}_${chap.section_number}`;
  const isPublished = key in publishedImages;
  const heroImage = publishedImages[key] || null;
  const url = `/comics/ramayana/${book.slug}/${chap.book_id}_Chapter_${chap.section_number}/`;
  
  return {
    ...chap,
    isPublished,
    heroImage,
    url
  };
});

const readyCount = chapterList.filter(c => c.isPublished).length;
---

<Layout title={`${book.name} (${book.sanskrit}) - Ramayana Comics - Thinking Buffer`}>
  <div class="book-detail-container">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/comics">Comics</a>
      <span class="sep">/</span>
      <a href="/comics/ramayana">Ramayana</a>
      <span class="sep">/</span>
      <span class="cur">{book.name}</span>
    </nav>

    <!-- Book Hero -->
    <header class="book-hero card">
      <div class="hero-header-row">
        <span class="book-num-badge">Book {book.book_num} of 7</span>
        <span class="sanskrit-title-badge">{book.sanskrit}</span>
      </div>
      <h1 class="book-main-title">{book.name}</h1>
      <h2 class="book-sub-title">{book.english}</h2>
      <p class="book-full-desc">{book.desc}</p>

      <div class="book-stats-bar">
        <div class="b-stat">
          <strong>{chapterList.length}</strong>
          <span>Total Chapters</span>
        </div>
        <div class="b-stat">
          <strong>{book.total_words}</strong>
          <span>Source Words</span>
        </div>
        <div class="b-stat highlight">
          <strong>{readyCount} of {chapterList.length}</strong>
          <span>Comics Illustrated</span>
        </div>
      </div>
    </header>

    <!-- Kanda Quick Switcher -->
    <nav class="kanda-nav-pills">
      <span class="kanda-nav-label">Jump to Book:</span>
      <div class="pills-scroll">
        {allBooks.map((b) => (
          <a 
            href={`/comics/ramayana/${b.slug}/`} 
            class={`kanda-pill ${b.book_num === book.book_num ? 'active' : ''}`}
          >
            {b.book_num}. {b.name}
          </a>
        ))}
      </div>
    </nav>

    <!-- Search & Filter Bar -->
    <div class="book-search-bar">
      <div class="search-input-wrap">
        <svg class="s-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="text" 
          id="kandaSearchInput" 
          placeholder={`Search within ${book.name} (e.g. Sanskrit title, English keywords, Section)...`}
        />
      </div>
      <div class="filter-toggle-group">
        <button class="f-btn active" data-filter="all">All Chapters ({chapterList.length})</button>
        <button class="f-btn" data-filter="ready">Illustrated Only ✨ ({readyCount})</button>
      </div>
    </div>

    <!-- Chapter Grid -->
    <main class="kanda-chapters-grid" id="kandaChaptersList">
      {chapterList.map((chap) => (
        <article 
          class={`card chapter-item-card ${chap.isPublished ? 'is-ready' : 'is-upcoming'}`}
          data-status={chap.isPublished ? 'ready' : 'upcoming'}
          data-search={`${chap.thematic_sanskrit_title} ${chap.thematic_english_title} Section ${chap.roman} Chapter ${chap.section_number} ${chap.local_narrative_summary}`.toLowerCase()}
        >
          <!-- Thumbnail / Visual Header -->
          <div class="chapter-media-container">
            {chap.heroImage ? (
              <img src={chap.heroImage} alt={chap.thematic_english_title} class="chapter-thumb-img" loading="lazy" />
            ) : (
              <div class="chapter-thumb-placeholder">
                <div class="placeholder-graphic">
                  <span class="placeholder-sanskrit">{chap.thematic_sanskrit_title}</span>
                  <span class="placeholder-sec">Section {chap.roman}</span>
                </div>
              </div>
            )}
            <div class="readiness-overlay">
              {chap.isPublished ? (
                <span class="badge-ready">✨ Illustrated Comic Ready</span>
              ) : (
                <span class="badge-in-prod">⏳ Comic In Production</span>
              )}
            </div>
          </div>

          <!-- Content Body -->
          <div class="chapter-body">
            <div class="chapter-sec-row">
              <span class="sec-label">Section {chap.roman} • Chapter {chap.section_number}</span>
              <span class="wc-label">{chap.word_count.toLocaleString()} words</span>
            </div>

            <h3 class="sanskrit-title">{chap.thematic_sanskrit_title}</h3>
            <h4 class="english-title">{chap.thematic_english_title}</h4>

            <div class="chapter-action-row">
              <a href={chap.url} class={`chapter-action-btn ${chap.isPublished ? 'btn-ready' : 'btn-upcoming'}`}>
                {chap.isPublished ? 'Read Comic →' : 'Read Story & Synopsis →'}
              </a>
            </div>
          </div>
        </article>
      ))}
    </main>

    <!-- Empty search state -->
    <div id="noKandaResults" class="no-results card" style="display: none;">
      <h3>No chapters matched your search</h3>
      <p>Try searching with another keyword or reset the search field.</p>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('kandaSearchInput') as HTMLInputElement;
    const filterBtns = document.querySelectorAll('.f-btn');
    const cards = document.querySelectorAll('.chapter-item-card') as NodeListOf<HTMLElement>;
    const noResults = document.getElementById('noKandaResults');

    let currentSearch = '';
    let currentFilter = 'all';

    function applyFilters() {
      let visible = 0;
      const query = currentSearch.trim().toLowerCase();

      cards.forEach((card) => {
        const status = card.getAttribute('data-status') || '';
        const searchContent = card.getAttribute('data-search') || '';

        const matchesStatus = currentFilter === 'all' || status === currentFilter;
        const matchesQuery = query === '' || searchContent.includes(query);

        if (matchesStatus && matchesQuery) {
          card.style.display = 'flex';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visible === 0 ? 'block' : 'none';
      }
    }

    if (input) {
      input.addEventListener('input', (e) => {
        currentSearch = (e.target as HTMLInputElement).value;
        applyFilters();
      });
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });
  });
</script>

<style>
