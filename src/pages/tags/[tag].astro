---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  // Fetch all markdown files from blog
  const allPosts = Object.values(import.meta.glob('../blog/**/*.md', { eager: true }));
  
  // Extract all unique tags
  const uniqueTags = [...new Set(allPosts.map((post: any) => post.frontmatter.tags || []).flat())];
  
  // Generate a route for each tag
  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post: any) => 
      post.frontmatter.tags && post.frontmatter.tags.includes(tag)
    );
    
    // Sort filtered posts by date
    filteredPosts.sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
    
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

function getItemImage(item: any) {
  const url = item.frontmatter.heroImage || item.frontmatter.image_url;
  if (!url) return null;
  if (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('/')) {
    return url;
  }
  if (url.startsWith('./')) {
    const cleanUrl = (item.url || '').replace(/\/$/, '');
    return `/src/pages${cleanUrl}/${url.slice(2)}`;
  }
  return url;
}
---

<Layout title={`Posts tagged with "${tag}" - Thinking Buffer`}>
  <div class="tag-header">
    <a href="/" class="back-link">&larr; Back to Home</a>
    <h1>Posts tagged with <span class="tag-highlight">"{tag}"</span></h1>
  </div>
  
  <div class="card-grid tag-results">
    {posts.map((post: any) => (
      <a href={post.url} class="card article-card">
        {getItemImage(post) && (
          <div class="card-image-container">
            <img src={getItemImage(post)} alt={post.frontmatter.title} />
          </div>
        )}
        <h3 class="card-title">{post.frontmatter.title}</h3>
        <p class="author-meta">{new Date(post.frontmatter.date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        })}</p>
        <p class="card-excerpt">{post.frontmatter.description}</p>
        <div class="card-tags">
          {post.frontmatter.tags && post.frontmatter.tags.map((t: string) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .tag-header {
    margin-bottom: 3rem;
  }
  
  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--text-muted);
    font-weight: 500;
  }
  
  .back-link:hover {
    color: var(--text-color);
  }
  
  .tag-header h1 {
    font-size: 2.5rem;
  }
  
  .tag-highlight {
    color: var(--text-muted);
  }
  
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  
  @media (max-width: 900px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
  
  /* Shared card styles */
  .card-image-container {
    width: 100%;
    aspect-ratio: 4/3;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 1.25rem;
    background-color: #F3E5DC;
  }
  
  .card-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.5rem;
    color: #1A1A1A;
  }
  
  .author-meta {
    font-size: 0.8rem;
    color: #666;
    margin-bottom: 0.75rem;
  }
  
  .card-excerpt {
    font-size: 0.85rem;
    color: #555;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }
  
  .card-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: auto;
  }
  
  .tag {
    font-size: 0.7rem;
    background: #F1F1F1;
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
    color: #555;
    font-weight: 500;
  }
</style>
