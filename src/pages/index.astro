---
import Layout from '../layouts/Layout.astro';

// Fetch all blog posts
const blogs = Object.values(import.meta.glob('./blog/**/*.md', { eager: true }))
  .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());

function getItemImage(item: any) {
  const url = item.frontmatter.heroImage || item.frontmatter.image_url;
  if (!url) return null;
  if (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('/')) {
    return url;
  }
  if (url.startsWith('./')) {
    const cleanUrl = (item.url || '').replace(/\/$/, '');
    return `/src/pages${cleanUrl}/${url.slice(2)}`;
  }
  return url;
}
---

<Layout title="Thinking Buffer - Thoughts & Deep Articles">

	<div class="home-feed-sections">
		<!-- Section 1: Latest Articles -->
		<section class="feed-section">
			<div class="section-header">
				<h2 class="section-title">Latest Articles</h2>
			</div>
			
			<div class="card-grid">
				{blogs.length === 0 ? (
					<p class="no-content">No articles yet.</p>
				) : (
					blogs.map((post: any) => (
						<a href={post.url} class="card article-card">
							{getItemImage(post) && (
								<div class="card-image-container">
									<img src={getItemImage(post)} alt={post.frontmatter.title} />
								</div>
							)}
							<h3 class="card-title">{post.frontmatter.title}</h3>
							<p class="author-meta">
								{new Date(post.frontmatter.date).toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric'
								})}
							</p>
							<p class="card-excerpt">{post.frontmatter.description}</p>
							{post.frontmatter.tags && (
								<div class="card-tags">
									{post.frontmatter.tags.map((tag: string) => (
										<span class="tag">{tag}</span>
									))}
								</div>
							)}
						</a>
					))
				)}
			</div>
		</section>

		<!-- Section 2: Comics & Graphic Stories (Below Articles) -->
		<section class="feed-section">
			<div class="section-header">
				<h2 class="section-title">Comics & Graphic Stories</h2>
			</div>

			<div class="card-grid">
				<!-- Ramayana Graphic Novel Series Card -->
				<a href="/comics/ramayana" class="card article-card comic-feature-card">
					<div class="card-image-container">
						<img 
							src="/images/comics/ramayana_hero.jpg" 
							alt="The Valmiki Ramayana - Graphic Series" 
						/>
					</div>
					<h3 class="card-title">The Valmiki Ramayana: Graphic Odyssey</h3>
					<p class="author-meta">
						August 23, 2026 • 7 Books • 652 Chapters
					</p>
					<p class="card-excerpt">A complete 1-to-1 visual comic adaptation mapped directly from Manmatha Nath Dutt's 1891 prose translation across all 7 Kāṇḍas.</p>
					<div class="card-tags">
						<span class="tag">Ramayana</span>
						<span class="tag">Comics</span>
						<span class="tag">Mythology</span>
					</div>
				</a>
			</div>
		</section>
	</div>
</Layout>

<style>
	/* Stacked Layout Sections */
	.home-feed-sections {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}
	
	.section-title {
		font-size: 1.8rem;
		margin-bottom: 2rem;
		color: #1A1A1A;
	}
	
	.card-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}
	
	@media (max-width: 1000px) {
		.card-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	
	@media (max-width: 600px) {
		.card-grid {
			grid-template-columns: 1fr;
		}
	}
	
	/* Card Enhancements */
	.card {
		padding: 1.25rem;
	}
	
	.card-image-container {
		position: relative;
		width: 100%;
		aspect-ratio: 4/3;
		border-radius: 12px;
		overflow: hidden;
		margin-bottom: 1.25rem;
		background-color: #F3E5DC;
	}
	
	.card-image-container img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	
	.card-title {
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.3;
		margin-bottom: 0.5rem;
		color: #1A1A1A;
	}
	
	.author-meta {
		font-size: 0.8rem;
		color: #666;
		margin-bottom: 0.75rem;
	}
	
	.card-excerpt {
		font-size: 0.85rem;
		color: #555;
		margin-bottom: 1.5rem;
		flex-grow: 1;
	}
	
	.card-tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	
	.tag {
		font-size: 0.7rem;
		background: #F1F1F1;
		padding: 0.25rem 0.6rem;
		border-radius: 100px;
		color: #555;
		font-weight: 500;
	}
	
	.no-content {
		color: var(--text-muted);
		font-size: 1rem;
	}
</style>
