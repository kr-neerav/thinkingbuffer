---
import Layout from '../layouts/Layout.astro';

// Fetch all blog posts
const blogs = Object.values(import.meta.glob('./blog/**/*.md', { eager: true }))
  .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());

// Fetch all comic posts
const comics = Object.values(import.meta.glob('./comics/**/*.md', { eager: true }))
  .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<Layout title="Thinking Buffer - Thoughts & Comics">
	<section class="hero-section">
		<div class="hero-content">
			<h1>Explore the depths of ideas and visual stories.</h1>
			<p class="subtitle">Explore the depths of ideas and visual stories, and blogged comic platform. Soft Minimal.</p>
		</div>
		<div class="hero-illustration">
			<img src="https://images.unsplash.com/photo-1596495578065-6e0763fa1178?q=80&w=600&auto=format&fit=crop" alt="Illustration" class="illustration-img" />
		</div>
	</section>
	
	<div class="home-feed-sections">
		<!-- Featured Articles -->
		<section class="feed-section">
			<h2 class="section-title">Featured Articles</h2>
			<div class="card-grid">
				{blogs.length === 0 ? (
					<p class="no-content">No articles yet.</p>
				) : (
					blogs.slice(0, 4).map((post: any) => (
						<a href={post.url} class="card article-card">
							{post.frontmatter.heroImage && (
								<div class="card-image-container">
									<img src={post.frontmatter.heroImage} alt={post.frontmatter.title} />
								</div>
							)}
							<h3 class="card-title">{post.frontmatter.title}</h3>
							<p class="author-meta">
								{new Date(post.frontmatter.date).toLocaleDateString('en-US', {
									year: 'numeric',
									month: 'long',
									day: 'numeric'
								})}
							</p>
							<p class="card-excerpt">{post.frontmatter.description}</p>
							{post.frontmatter.tags && (
								<div class="card-tags">
									{post.frontmatter.tags.map((tag: string) => (
										<span class="tag">{tag}</span>
									))}
								</div>
							)}
						</a>
					))
				)}
			</div>
		</section>
		
		<!-- Latest Comics -->
		<section class="feed-section">
			<h2 class="section-title">Latest Comics</h2>
			<div class="card-grid">
				{comics.length === 0 ? (
					<p class="no-content">No comics yet. Stay tuned!</p>
				) : (
					comics.slice(0, 4).map((comic: any) => (
						<a href={comic.url} class="card comic-card">
							{comic.frontmatter.image_url && (
								<div class="comic-image-container">
									<img src={comic.frontmatter.image_url} alt={comic.frontmatter.title} />
								</div>
							)}
							<div class="comic-content">
								<h3 class="card-title">{comic.frontmatter.title}</h3>
								<p class="comic-meta">
									{new Date(comic.frontmatter.date).toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'long',
										day: 'numeric'
									})}
								</p>
							</div>
						</a>
					))
				)}
			</div>
		</section>
	</div>
</Layout>

<style>
	/* Hero Section */
	.hero-section {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
		margin-bottom: 5rem;
		padding-top: 2rem;
	}
	
	.hero-content h1 {
		font-size: 3.5rem;
		line-height: 1.1;
		margin-bottom: 1.5rem;
		color: #1A1A1A;
	}
	
	.hero-content .subtitle {
		font-size: 1.15rem;
		color: #4A4A4A;
		max-width: 90%;
		line-height: 1.5;
	}
	
	.hero-illustration {
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
	}
	
	.illustration-img {
		width: 100%;
		max-width: 400px;
		height: auto;
		border-radius: 20px;
		mix-blend-mode: multiply; /* Helps placeholder blend into pastel bg */
	}
	
	@media (max-width: 900px) {
		.hero-section {
			grid-template-columns: 1fr;
			gap: 2rem;
			text-align: center;
		}
		.hero-content .subtitle {
			margin: 0 auto;
		}
		.hero-illustration {
			order: -1;
		}
	}
	
	/* Stacked Layout Sections */
	.home-feed-sections {
		display: flex;
		flex-direction: column;
		gap: 5rem;
	}
	
	.section-title {
		font-size: 1.8rem;
		margin-bottom: 2rem;
		color: #1A1A1A;
	}
	
	.card-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}
	
	@media (max-width: 1000px) {
		.card-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	
	@media (max-width: 600px) {
		.card-grid {
			grid-template-columns: 1fr;
		}
	}
	
	/* Card Enhancements */
	.card {
		padding: 1.25rem;
	}
	
	.card-image-container {
		width: 100%;
		aspect-ratio: 4/3;
		border-radius: 12px;
		overflow: hidden;
		margin-bottom: 1.25rem;
		background-color: #F3E5DC; /* matching mockup */
	}
	
	.card-image-container img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	
	.card-title {
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.3;
		margin-bottom: 0.5rem;
		text-transform: uppercase;
		color: #1A1A1A;
	}
	
	.author-meta {
		font-size: 0.8rem;
		color: #666;
		margin-bottom: 0.75rem;
	}
	
	.card-excerpt {
		font-size: 0.85rem;
		color: #555;
		margin-bottom: 1.5rem;
		flex-grow: 1;
	}
	
	.card-tags {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	
	.tag {
		font-size: 0.7rem;
		background: #F1F1F1;
		padding: 0.25rem 0.6rem;
		border-radius: 100px;
		color: #555;
		font-weight: 500;
	}
	
	/* Comic specific overrides */
	.comic-image-container {
		width: 100%;
		aspect-ratio: 1/1; /* Mockup shows square comics */
		border-radius: 12px;
		overflow: hidden;
		margin-bottom: 1rem;
	}
	
	.comic-image-container img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	
	.empty-placeholder {
		background-color: #C4C4C4;
	}
	
	.comic-category {
		font-size: 0.75rem;
		color: #666;
		margin-bottom: 0.25rem;
		display: block;
	}
	
	.comic-meta {
		font-size: 0.8rem;
		color: #666;
		margin-bottom: 0;
	}
</style>
