---
import Layout from '../../layouts/Layout.astro';

// Fetch all markdown files in this directory and any subdirectories
const posts = Object.values(import.meta.glob('./**/*.md', { eager: true })) as any[];

// Sort posts by date, newest first
posts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());

function getItemImage(item: any) {
  const url = item.frontmatter.heroImage || item.frontmatter.image_url;
  if (!url) return null;
  if (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('/')) {
    return url;
  }
  if (url.startsWith('./')) {
    const cleanUrl = (item.url || '').replace(/\/$/, '');
    return `/src/pages${cleanUrl}/${url.slice(2)}`;
  }
  return url;
}

const monthNames = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December'
];

interface DateTree {
  [year: string]: {
    year: string;
    count: number;
    months: {
      [monthKey: string]: {
        monthKey: string;
        monthName: string;
        count: number;
        days: {
          [dateKey: string]: {
            dateKey: string;
            dayStr: string;
            displayDate: string;
            count: number;
          };
        };
      };
    };
  };
}

const dateTree: DateTree = {};

posts.forEach((post) => {
  const d = new Date(post.frontmatter.date);
  const year = String(d.getUTCFullYear());
  const monthNum = String(d.getUTCMonth() + 1).padStart(2, '0');
  const monthName = monthNames[d.getUTCMonth()];
  const monthKey = `${year}-${monthNum}`;
  const dayStr = String(d.getUTCDate()).padStart(2, '0');
  const dateKey = `${year}-${monthNum}-${dayStr}`;
  const displayDate = `${monthName} ${dayStr}, ${year}`;

  if (!dateTree[year]) {
    dateTree[year] = { year, count: 0, months: {} };
  }
  dateTree[year].count++;

  if (!dateTree[year].months[monthKey]) {
    dateTree[year].months[monthKey] = {
      monthKey,
      monthName,
      count: 0,
      days: {}
    };
  }
  dateTree[year].months[monthKey].count++;

  if (!dateTree[year].months[monthKey].days[dateKey]) {
    dateTree[year].months[monthKey].days[dateKey] = {
      dateKey,
      dayStr,
      displayDate,
      count: 0
    };
  }
  dateTree[year].months[monthKey].days[dateKey].count++;
});

// Sort years descending
const sortedYears = Object.keys(dateTree).sort((a, b) => b.localeCompare(a));
---

<Layout title="All Articles - Thinking Buffer">
  <div class="archive-header">
    <a href="/" class="back-link">← Back to Home</a>
    <div class="header-content">
      <h1 class="archive-title">All Articles</h1>
      <p class="archive-subtitle">
        Ordered chronologically by publication date. Explore the archive by year, month, and date on the right.
      </p>
    </div>
  </div>

  <div class="archive-layout">
    <!-- Main Articles Stream -->
    <section class="archive-feed" aria-label="Articles Feed">
      <div id="filter-banner" class="filter-banner" style="display: none;">
        <span>Showing articles for <strong id="filter-date-label"></strong></span>
        <button type="button" id="clear-filter-btn" class="clear-filter-btn">Show all articles</button>
      </div>

      <div class="articles-list" id="articles-list">
        {posts.map((post) => {
          const d = new Date(post.frontmatter.date);
          const year = String(d.getUTCFullYear());
          const monthNum = String(d.getUTCMonth() + 1).padStart(2, '0');
          const monthKey = `${year}-${monthNum}`;
          const dayStr = String(d.getUTCDate()).padStart(2, '0');
          const dateKey = `${year}-${monthNum}-${dayStr}`;
          const monthName = monthNames[d.getUTCMonth()];
          const displayDate = `${monthName} ${dayStr}, ${year}`;

          return (
            <article
              class="card archive-card"
              data-year={year}
              data-month={monthKey}
              data-date={dateKey}
            >
              {getItemImage(post) && (
                <a href={post.url} class="card-thumb-link" tabindex="-1" aria-hidden="true">
                  <div class="card-thumb-container">
                    <img src={getItemImage(post)} alt={post.frontmatter.title} loading="lazy" />
                  </div>
                </a>
              )}
              <div class="card-body">
                <div class="card-meta">
                  <time datetime={dateKey} class="meta-date">{displayDate}</time>
                  <span class="meta-divider">•</span>
                  <span class="meta-date-iso">{dateKey}</span>
                </div>
                <h2 class="card-title">
                  <a href={post.url} class="card-title-link">{post.frontmatter.title}</a>
                </h2>
                {post.frontmatter.description && (
                  <p class="card-description">{post.frontmatter.description}</p>
                )}
                {post.frontmatter.tags && post.frontmatter.tags.length > 0 && (
                  <div class="card-tags">
                    {post.frontmatter.tags.map((tag: string) => (
                      <a href={`/tags/${tag}`} class="tag">{tag}</a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <div id="no-results" class="no-results" style="display: none;">
        <p>No articles found for the selected timeframe.</p>
        <button type="button" id="reset-filter-btn" class="clear-filter-btn">Show all articles</button>
      </div>
    </section>

    <!-- Right-Hand Hierarchical Dates Sidebar -->
    <aside class="archive-sidebar" aria-label="Filter by Publication Date">
      <div class="sidebar-card">
        <div class="sidebar-header">
          <h2 class="sidebar-title">Archive</h2>
          <span class="sidebar-count">{posts.length} articles</span>
        </div>

        <!-- All Articles reset button -->
        <button
          type="button"
          class="tree-filter-btn all-articles-btn active"
          data-type="all"
          data-value="all"
          data-label="All Articles"
        >
          <span class="tree-label">All Articles</span>
          <span class="tree-badge">{posts.length}</span>
        </button>

        <div class="date-tree">
          {sortedYears.map((yearKey) => {
            const yearData = dateTree[yearKey];
            const sortedMonthKeys = Object.keys(yearData.months).sort((a, b) => b.localeCompare(a));

            return (
              <details class="tree-details year-details" open data-year-container={yearKey}>
                <summary class="tree-summary year-summary">
                  <span class="chevron-wrapper" aria-hidden="true">
                    <svg class="chevron-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </span>
                  <button
                    type="button"
                    class="tree-filter-btn year-btn"
                    data-type="year"
                    data-value={yearKey}
                    data-label={`${yearKey}`}
                  >
                    <span class="tree-label">{yearKey}</span>
                    <span class="tree-badge">{yearData.count}</span>
                  </button>
                </summary>

                <div class="tree-children months-container">
                  {sortedMonthKeys.map((monthKey) => {
                    const monthData = yearData.months[monthKey];
                    const sortedDateKeys = Object.keys(monthData.days).sort((a, b) => b.localeCompare(a));

                    return (
                      <details class="tree-details month-details" open data-month-container={monthKey}>
                        <summary class="tree-summary month-summary">
                          <span class="chevron-wrapper" aria-hidden="true">
                            <svg class="chevron-svg" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                          </span>
                          <button
                            type="button"
                            class="tree-filter-btn month-btn"
                            data-type="month"
                            data-value={monthKey}
                            data-label={`${monthData.monthName} ${yearKey}`}
                          >
                            <span class="tree-label">{monthData.monthName}</span>
                            <span class="tree-badge">{monthData.count}</span>
                          </button>
                        </summary>

                        <div class="tree-children days-container">
                          {sortedDateKeys.map((dateKey) => {
                            const dayData = monthData.days[dateKey];

                            return (
                              <button
                                type="button"
                                class="tree-filter-btn day-btn"
                                data-type="date"
                                data-value={dateKey}
                                data-label={`${monthData.monthName} ${dayData.dayStr}, ${yearKey}`}
                              >
                                <span class="tree-label">{dayData.dayStr}</span>
                                <span class="tree-badge">{dayData.count}</span>
                              </button>
                            );
                          })}
                        </div>
                      </details>
                    );
                  })}
                </div>
              </details>
            );
          })}
        </div>
      </div>
    </aside>
  </div>
</Layout>

<script>
  function setupDateFilter() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.tree-filter-btn');
    const articles = document.querySelectorAll<HTMLElement>('.archive-card');
    const banner = document.getElementById('filter-banner');
    const bannerLabel = document.getElementById('filter-date-label');
    const clearBtn = document.getElementById('clear-filter-btn');
    const resetBtn = document.getElementById('reset-filter-btn');
    const noResults = document.getElementById('no-results');

    function applyFilter(filterType: string, filterValue: string, labelText?: string, updateUrl: boolean = true) {
      filterButtons.forEach((btn) => {
        const isMatch = btn.dataset.type === filterType && btn.dataset.value === filterValue;
        btn.classList.toggle('active', isMatch);
        btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
      });

      let matchCount = 0;
      articles.forEach((card) => {
        const cardYear = card.dataset.year;
        const cardMonth = card.dataset.month;
        const cardDate = card.dataset.date;

        let isMatch = false;
        if (filterType === 'all') {
          isMatch = true;
        } else if (filterType === 'year' && cardYear === filterValue) {
          isMatch = true;
        } else if (filterType === 'month' && cardMonth === filterValue) {
          isMatch = true;
        } else if (filterType === 'date' && cardDate === filterValue) {
          isMatch = true;
        }

        if (isMatch) {
          card.style.display = 'grid';
          matchCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = matchCount === 0 ? 'block' : 'none';
      }

      if (banner && bannerLabel) {
        if (filterType === 'all') {
          banner.style.display = 'none';
        } else {
          banner.style.display = 'flex';
          const label = labelText || filterValue;
          bannerLabel.textContent = `${label} (${matchCount} ${matchCount === 1 ? 'article' : 'articles'})`;
        }
      }

      if (updateUrl) {
        if (filterType === 'all') {
          history.replaceState(null, '', window.location.pathname);
        } else {
          window.location.hash = filterValue;
        }
      }
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation(); // prevent collapsing summary when filtering
        const parentDetails = btn.closest('details');
        if (parentDetails && !parentDetails.open) {
          parentDetails.open = true;
        }
        const filterType = btn.dataset.type || 'all';
        const filterValue = btn.dataset.value || 'all';
        const label = btn.dataset.label || btn.innerText;
        applyFilter(filterType, filterValue, label);
      });
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => applyFilter('all', 'all', 'All Articles'));
    }
    if (resetBtn) {
      resetBtn.addEventListener('click', () => applyFilter('all', 'all', 'All Articles'));
    }

    // Handle initial hash in URL (e.g. #2026, #2026-10, #2026-10-13)
    if (window.location.hash) {
      const hashVal = window.location.hash.replace(/^#/, '');
      const matchingBtn = document.querySelector<HTMLButtonElement>(`.tree-filter-btn[data-value="${hashVal}"]`);
      if (matchingBtn) {
        // Ensure its parent details elements are opened
        let parent = matchingBtn.parentElement;
        while (parent) {
          if (parent.tagName === 'DETAILS') {
            (parent as HTMLDetailsElement).open = true;
          }
          parent = parent.parentElement;
        }
        const filterType = matchingBtn.dataset.type || 'all';
        const label = matchingBtn.dataset.label || matchingBtn.innerText;
        applyFilter(filterType, hashVal, label, false);
      }
    }
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', setupDateFilter);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupDateFilter();
  }
</script>

<style>
  .archive-header {
    margin-bottom: 2.5rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .back-link:hover {
    color: var(--text-color);
  }

  .archive-title {
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
    color: #1A1A1A;
  }

  .archive-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 0;
  }

  .archive-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 2.5rem;
    align-items: start;
  }

  .filter-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #FFFFFF;
    padding: 0.75rem 1.25rem;
    border-radius: 12px;
    box-shadow: var(--shadow-soft);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: #1A1A1A;
  }

  .clear-filter-btn {
    background: #F1F1F1;
    border: none;
    border-radius: 100px;
    padding: 0.35rem 0.85rem;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    color: #333333;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .clear-filter-btn:hover {
    background: #000000;
    color: #FFFFFF;
  }

  .articles-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .archive-card {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-card);
    background: var(--card-bg);
    box-shadow: var(--shadow-soft);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .archive-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .card-thumb-link {
    display: block;
  }

  .card-thumb-container {
    width: 100%;
    aspect-ratio: 16/10;
    border-radius: 10px;
    overflow: hidden;
    background-color: #F3E5DC;
  }

  .card-thumb-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #666666;
    margin-bottom: 0.5rem;
  }

  .meta-divider {
    color: #CCCCCC;
  }

  .meta-date-iso {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    background: #F1F5F9;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    color: #475569;
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.6rem;
  }

  .card-title-link {
    color: #1A1A1A;
    text-decoration: none;
  }

  .card-title-link:hover {
    color: #0066cc;
  }

  .card-description {
    font-size: 0.9rem;
    color: #555555;
    line-height: 1.5;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .tag {
    font-size: 0.72rem;
    background: #F1F1F1;
    padding: 0.2rem 0.55rem;
    border-radius: 100px;
    color: #555555;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .tag:hover {
    background: #E2E8F0;
    color: #1A1A1A;
  }

  /* Right-hand Sidebar */
  .archive-sidebar {
    position: sticky;
    top: 2rem;
  }

  .sidebar-card {
    background: var(--card-bg);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
    padding: 1.25rem;
  }

  .sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .sidebar-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #1A1A1A;
    margin-bottom: 0;
  }

  .sidebar-count {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .all-articles-btn {
    width: 100%;
    margin-bottom: 0.75rem;
  }

  /* Tree hierarchy styling */
  .date-tree {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: calc(100vh - 14rem);
    overflow-y: auto;
    padding-right: 0.25rem;
  }

  .tree-details {
    width: 100%;
  }

  .tree-summary {
    list-style: none;
    display: flex;
    align-items: center;
    cursor: pointer;
    user-select: none;
    padding: 0.15rem 0;
  }

  .tree-summary::-webkit-details-marker {
    display: none;
  }

  .chevron-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    color: #888888;
    transition: transform 0.2s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .tree-details[open] > .tree-summary > .chevron-wrapper {
    transform: rotate(90deg);
    color: #1A1A1A;
  }

  .tree-filter-btn {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex: 1;
    padding: 0.45rem 0.65rem;
    border: none;
    border-radius: 8px;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    color: #333333;
    transition: background 0.15s ease, color 0.15s ease;
    text-align: left;
  }

  .tree-filter-btn:hover {
    background: #F1F5F9;
    color: #000000;
  }

  .tree-filter-btn.active {
    background: #1A1A1A;
    color: #FFFFFF;
  }

  .year-btn .tree-label {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .month-btn .tree-label {
    font-weight: 600;
    font-size: 0.88rem;
  }

  .day-btn .tree-label {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-weight: 500;
    font-size: 0.84rem;
  }

  .tree-badge {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.15rem 0.45rem;
    border-radius: 100px;
    background: #ECEFF1;
    color: #555555;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .tree-filter-btn.active .tree-badge {
    background: rgba(255, 255, 255, 0.25);
    color: #FFFFFF;
  }

  /* Indented tree levels */
  .months-container {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-left: 0.85rem;
    margin-top: 0.25rem;
    border-left: 1px solid rgba(0, 0, 0, 0.06);
  }

  .days-container {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-left: 1.1rem;
    margin-top: 0.2rem;
    border-left: 1px solid rgba(0, 0, 0, 0.06);
  }

  .day-btn {
    padding: 0.35rem 0.65rem;
  }

  .no-results {
    background: #FFFFFF;
    padding: 2.5rem;
    border-radius: var(--radius-card);
    text-align: center;
    box-shadow: var(--shadow-soft);
  }

  .no-results p {
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  @media (max-width: 900px) {
    .archive-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .archive-sidebar {
      position: static;
      order: -1;
    }

    .date-tree {
      max-height: none;
    }

    .archive-card {
      grid-template-columns: 1fr;
    }

    .card-thumb-container {
      aspect-ratio: 16/9;
    }
  }
</style>
